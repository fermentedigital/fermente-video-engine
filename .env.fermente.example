# FERMENTE local secrets template. Copy values into your shell/environment.
# Never commit real credentials.

# Required for automatic script generation
FERMENTE_OPENAI_API_KEY=

# At least one stock media provider is required
FERMENTE_PEXELS_API_KEY=
FERMENTE_PIXABAY_API_KEY=

# Recommended before exposing the API outside localhost
FERMENTE_ENGINE_API_KEY=

# Optional higher-quality TTS; Edge TTS remains the free default
FERMENTE_FISH_API_KEY=
